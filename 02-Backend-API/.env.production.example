# =====================================================================
#  AIN PLATFORM — PRODUCTION ENVIRONMENT TEMPLATE
#  Copy this file to .env and fill in the real values before deploying.
# =====================================================================

# ─── Application ─────────────────────────────────────────────────────
APP_NAME="AIN Platform"
APP_ENV=production
APP_KEY=                    # php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

# ─── Database ────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=                    # Managed DB host (e.g. PlanetScale, Supabase, Railway)
DB_PORT=3306
DB_DATABASE=ain_production
DB_USERNAME=                # DB user
DB_PASSWORD=                # DB password

# ─── Cache / Queue ───────────────────────────────────────────────────
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=                 # Redis host (Upstash, Redis Cloud, Railway)
REDIS_PASSWORD=
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=              # Resend / SendGrid API key
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Storage (S3-compatible) ─────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ain-content-production
AWS_URL=                    # CDN URL for signed playback (Cloudflare R2 / S3)
AWS_ENDPOINT=               # Required for Cloudflare R2

# ─── Pusher / Soketi (Real-time) ─────────────────────────────────────
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# ─── Firebase (Push Notifications) ───────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
FCM_SERVER_KEY=

# ─── Payment Gateways ─────────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ─── Zoom (Live Meetings) ─────────────────────────────────────────────
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# ─── Google Meet (optional) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── Security ─────────────────────────────────────────────────────────
AIO_REFRESH_COOKIE=ain_refresh
AIO_REFRESH_TOKEN_DAYS=30
AIO_COOKIE_SECURE=true
AIO_COOKIE_SAME_SITE=None

# ─── Logging ──────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_SLACK_WEBHOOK_URL=

# ─── Sentry (Error Tracking) ──────────────────────────────────────────
SENTRY_LARAVEL_DSN=

# ─── Deployment ───────────────────────────────────────────────────────
# This file should NEVER be committed to Git.
# Inject via your host environment secrets UI.
