APP_NAME="AIN Platform API (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
AIO_DEPLOYMENT_MODE=staging

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ain_staging
DB_USERNAME=ain_user
DB_PASSWORD=your_secure_postgres_password

# Caching & Sessions: Redis
SESSION_DRIVER=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=your_secure_redis_password
REDIS_PORT=6379

# Queue: Redis Worker
QUEUE_CONNECTION=redis

# Private Object Storage: S3 / Cloudflare R2 / MinIO
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=ain-content-staging-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Email Delivery: SMTP / Mailpit
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@staging.ainplatform.com
MAIL_FROM_NAME="AIN Platform Staging"

# Malware Scanning: ClamAV Daemon TCP Service
MALWARE_SCANNER_DRIVER=clamav
CLAMAV_TRANSPORT=tcp
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=15
CLAMAV_FAIL_CLOSED=true
MALWARE_ACTION_ON_THREAT=quarantine

# Electronic Payments: Paymob
PAYMENT_GATEWAY_DRIVER=paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_SANDBOX_MODE=true
PAYMOB_ALLOW_SIMULATION=true
PAYMOB_FEE_PERCENT=2.75
PAYMOB_FEE_FIXED_MINOR=300

