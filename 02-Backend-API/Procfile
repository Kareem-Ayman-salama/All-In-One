web: sh -c 'test -n "$APP_KEY" && test "$DB_CONNECTION" = "pgsql" && php artisan migrate --force && php artisan optimize && if [ "$AIO_DEPLOYMENT_MODE" = "production" ]; then php artisan aio:production-check; fi && exec php artisan serve --host=0.0.0.0 --port=$PORT'
worker: php artisan queue:work redis --queue=outbox,default --sleep=2 --tries=5 --timeout=120 --max-time=3600
scheduler: php artisan schedule:work
