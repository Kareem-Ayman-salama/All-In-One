AIN_FLAVOR=development
AIN_API_BASE_URL=http://localhost:8000/api/v1
AIN_ENABLE_CRASH_REPORTING=false
AIN_ALLOW_MOCK_DATA=false

# Staging example:
# AIN_FLAVOR=staging
# AIN_API_BASE_URL=https://staging-api.example.com/api/v1
# AIN_ENABLE_CRASH_REPORTING=true
# AIN_ALLOW_MOCK_DATA=false

# Production example:
# AIN_FLAVOR=production
# AIN_API_BASE_URL=https://api.example.com/api/v1
# AIN_ENABLE_CRASH_REPORTING=true
# AIN_ALLOW_MOCK_DATA=false
