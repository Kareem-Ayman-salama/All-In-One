APP_NAME="AIO API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_BACKEND_HOST
AIO_DEPLOYMENT_MODE=production
AIO_DEMO_ACCESS_ENABLED=false

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
FRONTEND_URL=https://YOUR_FRONTEND_HOST
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_HOST

BCRYPT_ROUNDS=12
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE=aio_refresh_token
MAX_ACTIVE_SESSIONS_PER_USER=1
DEVICE_APPROVAL_REQUIRED=true
MAX_APPROVED_DEVICES_PER_MEMBER=1
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CONTENT_UPLOAD_MAX_KB=51200
QUEUE_CONNECTION=sync
CACHE_STORE=database

PUSH_PROVIDER=disabled
PUSH_QUEUE=notifications
PUSH_MAX_TOKENS_PER_JOB=100
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=
FCM_SERVICE_ACCOUNT_PATH=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=14

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="AIO - All In One"
