APP_NAME="AIO API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
AIO_DEPLOYMENT_MODE=staging
AIO_DEMO_ACCESS_ENABLED=false
AIO_DEMO_SUPER_ADMIN_EMAIL=
AIO_DEMO_SUPER_ADMIN_MFA_CODE=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE=aio_refresh_token
MAX_ACTIVE_SESSIONS_PER_USER=8
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aio
DB_USERNAME=aio
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CONTENT_UPLOAD_MAX_KB=51200
# Free trial mode: send verification email immediately without a separate worker service.
QUEUE_CONNECTION=sync
PUSH_PROVIDER=disabled
PUSH_QUEUE=notifications
PUSH_MAX_TOKENS_PER_JOB=100
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=
FCM_SERVICE_ACCOUNT_PATH=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
BACKUP_ENABLED=false
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=14

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_REQUIRED=false

# Brevo free transactional SMTP (300 emails/day).
# Keep credentials only in Railway Variables, never in this file.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="AIO - All In One"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
