{
  "info": {
    "_postman_id": "8d3a2990-0d21-4af5-8bb4-ain-api-flow",
    "name": "AIN API - Full Review Flow",
    "description": "Postman collection for the AIN Laravel backend review flow. Set base_url, then run Auth Login and the collection will store token/user/organization IDs when responses include them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://YOUR-BACKEND.up.railway.app/api/v1", "type": "string" },
    { "key": "frontend_url", "value": "https://YOUR-FRONTEND.up.railway.app", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "organization_id", "value": "", "type": "string" },
    { "key": "room_id", "value": "", "type": "string" },
    { "key": "room_membership_id", "value": "", "type": "string" },
    { "key": "content_id", "value": "", "type": "string" },
    { "key": "course_id", "value": "", "type": "string" },
    { "key": "batch_id", "value": "", "type": "string" },
    { "key": "booking_id", "value": "", "type": "string" },
    { "key": "academy_id", "value": "", "type": "string" },
    { "key": "subscription_id", "value": "", "type": "string" },
    { "key": "invitation_token", "value": "", "type": "string" },
    { "key": "notification_id", "value": "", "type": "string" },
    { "key": "device_id", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let json = {};",
          "try { json = pm.response.json(); } catch (e) {}",
          "const data = json.data || json;",
          "function setIf(key, value) { if (value !== undefined && value !== null && String(value).length) pm.collectionVariables.set(key, String(value)); }",
          "setIf('token', data.token || data.accessToken || data.access_token);",
          "setIf('refresh_token', data.refreshToken || data.refresh_token);",
          "setIf('user_id', data.user?.id || data.id);",
          "const firstWorkspace = Array.isArray(data.workspaces) ? data.workspaces[0] : null;",
          "const firstOrg = firstWorkspace?.organization || (Array.isArray(data.organizations) ? data.organizations[0] : null);",
          "setIf('organization_id', data.organization?.id || data.organizationId || firstOrg?.id);",
          "const list = Array.isArray(data) ? data : (Array.isArray(data.items) ? data.items : null);",
          "if (list && list[0]) {",
          "  const item = list[0];",
          "  if (pm.request.url.toString().includes('/rooms')) setIf('room_id', item.id);",
          "  if (pm.request.url.toString().includes('/content')) setIf('content_id', item.id);",
          "  if (pm.request.url.toString().includes('/courses')) setIf('course_id', item.id);",
          "  if (pm.request.url.toString().includes('/batches')) setIf('batch_id', item.id);",
          "  if (pm.request.url.toString().includes('/bookings')) setIf('booking_id', item.id);",
          "  if (pm.request.url.toString().includes('/academies')) setIf('academy_id', item.id);",
          "  if (pm.request.url.toString().includes('/notifications')) setIf('notification_id', item.id);",
          "  if (pm.request.url.toString().includes('/member-devices') || pm.request.url.toString().includes('/devices')) setIf('device_id', item.id);",
          "}",
          "setIf('room_id', data.room?.id || data.roomId || data.id);",
          "setIf('room_membership_id', data.roomMembership?.id || data.membership?.id);",
          "setIf('content_id', data.content?.id || data.contentId);",
          "setIf('course_id', data.course?.id || data.courseId);",
          "setIf('batch_id', data.batch?.id || data.batchId);",
          "setIf('booking_id', data.booking?.id || data.bookingId);",
          "pm.test('Response is not 500', function () { pm.expect(pm.response.code).to.be.below(500); });"
        ]
      }
    }
  ],
